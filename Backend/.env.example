# Port Aplikasi Backend
PORT=3000

# Secret Key untuk Token JWT
JWT_SECRET=rahasia_gudang_2026

# --- KONFIGURASI DATABASE ---
# Format Supabase: postgresql://postgres.ref:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Format Lokal: postgresql://postgres:password@localhost:5432/tugas_akhir_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/tugas_akhir_db

# Setel ke false untuk PostgreSQL lokal yang tidak menggunakan SSL
DB_SSL=false

# --- KONFIGURASI METODE PENYIMPANAN FOTO (STORAGE) ---
# Pilihan: 'local' (direkomendasikan untuk offline/PC teman) atau 'supabase' (menggunakan cloud)
STORAGE_PROVIDER=local

# URL utama server backend, digunakan untuk memetakan alamat foto lokal
APP_URL=http://localhost:3000

# --- KONFIGURASI SUPABASE (Hanya diperlukan jika STORAGE_PROVIDER=supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Key Pengaman untuk API Hardware ESP32
ESP32_API_KEY=akusukafurrysolid3x
